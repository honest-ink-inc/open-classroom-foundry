<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Foundry.Application\Foundry.Application.csproj" />
    <ProjectReference Include="..\Foundry.Infrastructure.Windows\Foundry.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\Foundry.Rendering\Foundry.Rendering.csproj" />
    <ProjectReference Include="..\Foundry.Storage\Foundry.Storage.csproj" />
    <ProjectReference Include="..\Foundry.Inference.AzureOpenAI\Foundry.Inference.AzureOpenAI.csproj" />
    <ProjectReference Include="..\Foundry.Modules.DeterministicPress\Foundry.Modules.DeterministicPress.csproj" />
    <ProjectReference Include="..\Foundry.Modules.BuiltIn\Foundry.Modules.BuiltIn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped CC0 symbol pack travels beside the executable; every file's
         rights record is CI-verified (RightsMetadataTests). -->
    <Content Include="..\..\assets\symbols\**\*" LinkBase="assets\symbols" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>