#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Refuse a commit that carries a secret — BEFORE it exists in history.
#
# The CI secret scan is a backstop, not the guard: it runs after a commit
# exists and, on a public repository, after history is public. The difference
# between catching a key here and catching it in CI is the difference between
# a non-event and rotate-everything-and-rewrite-history. This hook is the one
# protection that works while everyone is tired and it is two in the morning.
#
# Install:  pwsh tools/install-hooks.ps1     (or: git config core.hooksPath .githooks)

set -euo pipefail

# gitleaks cannot recognize a blind-study instrument: it is ordinary prose,
# not a credential-shaped value. Refuse the exact classes of file that this
# repository has already learned must never enter history. Deletions are
# deliberately excluded so removing a bad file can always be committed. A
# temporary NUL-delimited inventory keeps odd-but-valid filenames intact and,
# unlike a pipeline, lets the hook check git diff's own exit status.
staged_paths_file=$(mktemp "${TMPDIR:-/tmp}/ocf-precommit-paths.XXXXXX")
trap 'rm -f -- "$staged_paths_file"' EXIT HUP INT TERM
if ! git diff --cached --name-only --diff-filter=ACMR -z > "$staged_paths_file"; then
    echo "pre-commit: REFUSED — staged-path enumeration failed." >&2
    exit 1
fi

while IFS= read -r -d '' staged_path; do
    lower_path=$(printf '%s' "$staged_path" | tr '[:upper:]' '[:lower:]')
    base_name=${lower_path##*/}

    case "$base_name" in
        facilitator-key.md|seeded-packets.json|packet-*.print.html|secrets.json|id_rsa*|id_ed25519*|*.pem|*.key|*.pfx|*.p12|*.publishsettings)
            printf 'pre-commit: REFUSED — forbidden staged path: %s\n' "$staged_path" >&2
            cat >&2 <<'FORBIDDEN_PATH'

The staged path is a credential container, private-key convention, blind-study
definition/key, or generated study packet. Rename is not a remedy for study
content: keep the real instrument with the facilitator, outside this repository.
FORBIDDEN_PATH
            exit 1
            ;;
        .env|.env.*)
            if [ "$base_name" != ".env.example" ]; then
                printf 'pre-commit: REFUSED — forbidden staged path: %s\n' "$staged_path" >&2
                exit 1
            fi
            ;;
    esac

    case "$lower_path" in
        docs/evidence/pilot-kit/packet-*|*/docs/evidence/pilot-kit/packet-*)
            printf 'pre-commit: REFUSED — generated study packet staged: %s\n' "$staged_path" >&2
            exit 1
            ;;
    esac
done < "$staged_paths_file"

if [ "${OCF_SKIP_SECRET_HOOK:-}" = "1" ]; then
    echo "pre-commit: secret scan SKIPPED via OCF_SKIP_SECRET_HOOK=1." >&2
    echo "            A skip is an honest gap, never a pass — say so in the commit message." >&2
    exit 0
fi

if command -v gitleaks >/dev/null 2>&1; then
    GITLEAKS=gitleaks
elif [ -x "tools/bin/gitleaks" ]; then
    GITLEAKS="tools/bin/gitleaks"
elif [ -x "tools/bin/gitleaks.exe" ]; then
    GITLEAKS="tools/bin/gitleaks.exe"
else
    cat >&2 <<'MISSING'
pre-commit: REFUSED — gitleaks is not installed, so the staged secret scan cannot run.

  This hook refuses rather than waving the commit through, because a scan that
  silently does not run is worse than no scan: it reads as protection.

  Install it (any one of):
    winget install gitleaks
    scoop install gitleaks
    brew install gitleaks
    or drop the binary at tools/bin/gitleaks[.exe]

  If you genuinely cannot install it right now:
    OCF_SKIP_SECRET_HOOK=1 git commit ...
  and say in the commit message that the scan was skipped.
MISSING
    exit 1
fi

if ! "$GITLEAKS" git --staged --redact --no-banner; then
    cat >&2 <<'FOUND'

pre-commit: REFUSED — a secret was found in the staged changes.

  Nothing has been committed. The finding above is redacted; the real value is
  in your working tree.

  Do NOT commit and then "fix" it in a later commit. Git history is permanent,
  and on a public repository it is public. Remove the value from the staged
  file, and if the credential was ever real, ROTATE IT — assume it is burned.

  A false positive is possible. If this is genuinely not a secret, add a
  narrowly scoped rule to .gitleaks.toml with a comment saying why, rather
  than skipping the hook.
FOUND
    exit 1
fi

exit 0
