root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,editorconfig}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# The curated style pass (handover 2026-08-29, forge item 5). The blanket
# severity stays: it is what makes the full `dotnet format --verify-no-changes`
# gate meaningful. Below it, each rule the house deliberately varies on is
# curated to silent — taste is the author's; the gate enforces only idiom.
dotnet_analyzer_diagnostic.severity = warning
csharp_style_namespace_declarations = file_scoped:warning

# Interface members follow C# idiom (no redundant modifiers); everything else states its accessibility.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# The house writes `var`; neither direction is enforced.
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent
dotnet_diagnostic.IDE0007.severity = silent
dotnet_diagnostic.IDE0008.severity = silent

# Fluent calls (builder.Append…) discard their return values by design.
dotnet_diagnostic.IDE0058.severity = silent

# Arithmetic parentheses, expression vs block bodies, conditional-expression
# conversions, and primary constructors are author judgment, not idiom.
dotnet_diagnostic.IDE0048.severity = silent
dotnet_diagnostic.IDE0022.severity = silent
dotnet_diagnostic.IDE0046.severity = silent
dotnet_diagnostic.IDE0290.severity = silent

# A discard arm in a switch is a deliberate default, not a missing case.
dotnet_diagnostic.IDE0010.severity = silent
dotnet_diagnostic.IDE0072.severity = silent

# Namespaces are flat per assembly (Foundry.App.WinForms, not …WinForms.Localization).
dotnet_diagnostic.IDE0130.severity = silent

# Test fixtures hold JSON in plain strings on purpose; no raw-literal nagging.
dotnet_diagnostic.JSON002.severity = silent
