{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honest-ink.org/schemas/managed-pilot-upgrade-plan-1.json",
  "title": "Honest Ink managed pilot upgrade plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceLibraryRoot",
    "candidateLibraryRoot",
    "targetEngineVersion",
    "projects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "sourceLibraryRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "candidateLibraryRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "targetEngineVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceRelativePath",
          "destinationRelativePath",
          "sourceEngineVersion",
          "sourceSchemaVersion",
          "sourceSha256"
        ],
        "properties": {
          "sourceRelativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\\\*?]+\\.ocfproj$"
          },
          "destinationRelativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\\\*?]+\\.ocfproj$"
          },
          "sourceEngineVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "sourceSchemaVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          }
        }
      }
    }
  }
}
